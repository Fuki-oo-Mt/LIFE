# ===== 関所 (Sekisho) 環境変数サンプル =====
# これをコピーして .env を作成してください（.env はコミットされません）

# --- データベース ---
# ローカル開発: SQLite（すぐ動く）
DATABASE_URL="file:./dev.db"
# 本番: PostgreSQL（例）
# DATABASE_URL="postgresql://user:password@localhost:5432/sekisho?schema=public"

# --- データ源アダプタの選択 ---
# mock | live   ... mock=同梱サンプルで動作確認 / live=実データ源に接続
SEKISHO_MODE="mock"

# --- GitHub（問い合わせIssue・PR・リリース） ---
GITHUB_TOKEN=""
GITHUB_OWNER=""
GITHUB_REPO=""
# 問い合わせIssueを識別するラベル（カンマ区切り）
GITHUB_INQUIRY_LABELS="inquiry,問い合わせ"
GITHUB_INCIDENT_LABELS="incident,障害"
GITHUB_IMPROVEMENT_LABELS="improvement,改善"

# --- AWS CloudWatch（ログ→アラート／早期インシデント検知） ---
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# 監視対象のアラーム名プレフィックス（任意）
AWS_ALARM_PREFIX=""

# --- Snowflake（データ基盤の健全性・SLI） ---
SNOWFLAKE_ACCOUNT=""
SNOWFLAKE_USERNAME=""
SNOWFLAKE_PASSWORD=""
SNOWFLAKE_WAREHOUSE=""
SNOWFLAKE_DATABASE=""
SNOWFLAKE_SCHEMA=""

# --- Claude（AI所見・来週アクション。未設定ならテンプレ所見にフォールバック） ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

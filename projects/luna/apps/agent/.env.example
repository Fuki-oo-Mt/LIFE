# ============================================================
#  Project Luna — 頭脳（Backend）環境変数
# ============================================================
# LLMプロバイダの切り替えはこの一行だけ。
#   echo        … APIキー不要。ローカルデモ用（既定）
#   claude      … Anthropic Claude
#   gemini      … Google Gemini（推奨: 無料枠あり）
#   self_hosted … 自社/ローカルモデル（OpenAI互換API）= 将来の独立用
LLM_PROVIDER=gemini

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Gemini（推奨: 無料枠あり）---
# APIキーは https://aistudio.google.com/apikey で無料発行（クレカ登録不要）。
# 注意: 無料枠では入力がGoogleのモデル改善に利用されうる。機密データを扱う段階で有料枠へ。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 無料枠のレート制限(429)時に自動リトライする最大回数
GEMINI_MAX_RETRIES=3

# --- Self-hosted（自社モデル / Ollama / vLLM 等のOpenAI互換エンドポイント）---
SELF_HOSTED_BASE_URL=http://localhost:11434/v1
SELF_HOSTED_MODEL=luna-self
SELF_HOSTED_API_KEY=not-needed

# --- サーバ ---
HOST=0.0.0.0
PORT=8000
